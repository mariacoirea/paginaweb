{
  "redirects": [
    {
      "source": "/offerings",
      "destination": "/conversation",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/es",
      "destination": "/es.html"
    },
    {
      "source": "/es/(.*)",
      "destination": "/es.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
